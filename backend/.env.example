# PILOT / PRODUCTION config only. Dev and eval need NONE of this: with no .env the app
# boots in dev mode on the standard hosted provider (logged-in `claude` CLI, or
# ANTHROPIC_API_KEY). Copy this to backend/.env only for a real-data pilot, where
# generation must run on EU infrastructure you control. See docs/DEPLOY-SELFHOSTED-LLM.md.

# Operating mode: "dev" (default; /api/reset enabled, any LLM) or "pilot"
# (refuses to boot unless the self-hosted LLM is the active provider — the hard gate
# that keeps real member data off any external endpoint).
BRF_MODE=pilot

# Generation: self-hosted OpenAI-compatible endpoint (vLLM or Ollama).
BRF_LLM=selfhosted
BRF_LLM_BASE_URL=http://127.0.0.1:8000/v1
BRF_LLM_MODEL=gemma4:e12b
# BRF_LLM_API_KEY=change-me          # required if the LLM server enforces a bearer token
# BRF_LLM_TIMEOUT_S=300

# Data location (per-tenant stores + auth.db live under here).
# BRF_DATA_ROOT=/srv/brf/data

# Session lifetime in hours (default 336 = 14 days).
# BRF_SESSION_TTL_HOURS=336

# Embeddings: model2vec (default, downloads once) or "hashed" (offline).
# BRF_EMBEDDER=model2vec

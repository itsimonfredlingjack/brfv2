{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Träff",
  "mainBinaryName": "brfv2-desktop",
  "version": "0.2.0",
  "identifier": "se.brfdokumentai.desktop",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; script-src 'self'; style-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}

# Logs
logs
*.log

# Demo process state (PID files + logs for `make demo` / `make demo-stop`)
/.demo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Private customer documents & transfers — never commit
DONT_PUSH_brf_stuff/
wetransfer_*
docs-external/

# Backend runtime data, venvs, caches
backend/data/
backend/.venv/
backend/out/
src-tauri/target/
src-tauri/gen/
__pycache__/
*.pyc
.pytest_cache/
.model_cache/

# Secrets: real env files never commit; .env.example is the tracked template
.env
backend/.env
*.env
!*.env.example

# Evidence artifacts are committed selectively; eval scratch is not
backend/eval/last_run.json
backend/eval/last_planner_run.json
backend/eval/network_audit.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright MCP artifacts
.playwright-mcp/

# Playwright run artifacts from the canonical frontend's acceptance suite
test-results/
playwright-report/

# Byggda distributionsartefakter (stora binärer, spåras inte i git)
/artifacts/

# Desktop delivery build output. None of this is committed: it is reproducible
# from the tracked sources by `make desktop-package`.
#   src-tauri/runtime/  staged Python runtime + embedder weights (~776 MB)
#   /dist/              the built RPM (~548 MB) — already covered by the `dist`
#                       rule above, listed explicitly so its size is not a
#                       surprise to anyone reading this file
src-tauri/runtime/
/dist/

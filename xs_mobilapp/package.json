    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
